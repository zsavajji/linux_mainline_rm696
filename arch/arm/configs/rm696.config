# On top of omap2plus_defconfig. omapfb, not omapdrm: Harmattan's X and omaplfb drive /dev/fb0 with
# OMAPFB ioctls, and pvr needs omapfb's DSS notifier (omapfb-notify.patch)
# CONFIG_DRM_OMAP is not set
# CONFIG_DRM_PANEL_DSI_CM is not set
CONFIG_FB_OMAP2=y
CONFIG_FB_OMAP2_DSS_DSI=y
CONFIG_FB_OMAP2_PANEL_DSI_CM=y
# TV-out (display "tv"), which Harmattan's X driver requires
CONFIG_FB_OMAP2_CONNECTOR_ANALOG_TV=y
# The watchdogs as stock: DSME feeds /dev/watchdog (OMAP) and /dev/twl4030_wdt, any close stops them;
# the TWL5031's, which NOLO leaves running, runs 30 s from its probe until DSME opens it. The RAM-boot
# test init feeds both itself and makes them nowayout through sysfs (the test phone's way back to
# stock Harmattan: its power button is broken)
CONFIG_OMAP_WATCHDOG=y
CONFIG_TWL4030_WATCHDOG=y
# their sysfs (nowayout, which the test init sets)
CONFIG_WATCHDOG_SYSFS=y
# omap2fb.vram: fb0's memory exactly as stock reserves it (856x1536 RGB565, 3 buffers: 2629632 bytes),
# which Harmattan's X driver asks for: any other size, and omapfb reallocates it under X, losing
# preinit's boot image (omapfb's module is omap2fb)
# aegis.mode=open: Aegis in open mode (n9-qemu's credp: no confinement, root keeps its capabilities).
# No vhash: NOLO passes the phone's own, the SHA1 of Harmattan's /usr/sbin/validator-init (the Aegis
# policy loader the kernel runs first), which runs on Nokia's OMAP secure driver (CONFIG_OMAP3_SEC)
# dhash_entries/ihash_entries: the dentry and inode hash tables at half their default sizes (256 and
# 128 KiB instead of 512 and 256): RAM for Harmattan, below
# No proactive memory compaction (Linux 5.9+, not in 2.6.32): its timers keep an idle OMAP3 out of OFF
# mode, as Maemo Leste found on the N900; compaction on demand stays
CONFIG_CMDLINE="omap2fb.vram=0:2629632 aegis.mode=open nokia_modem.pm=0 phonet.phonet_gid=30012 cgroup.memory=nokmem sysctl.vm.compaction_proactiveness=0 dhash_entries=65536 ihash_entries=32768"
CONFIG_CMDLINE_EXTEND=y
# cgroup.memory=nokmem: memory cgroups count user pages only, as on stock (2.6.32 had no kernel memory
# accounting): every slab allocation of a fork or exit skips the memcg charge (2026-10-05: 300
# fork+exec+exit 1.65 -> 1.52 s)
CONFIG_PANIC_TIMEOUT=10
# OneNAND written as stock (CAL's "config" partition: libcal's BME, DSME, libbb5), page by page
# without a read-back as Nokia's kernel (rm581_defconfig); the RAM-boot test init makes it read-only
# (onenand_omap2.read_only). No mtdoops for now (stock wrote oopses to NOLO's "log" partition)
CONFIG_MTD_ONENAND=y
CONFIG_MTD_ONENAND_OMAP2=y
# CONFIG_MTD_ONENAND_VERIFY_WRITE is not set
# No OTP, as stock: a lock of the one-time-programmable area (Nokia's test servers have one) is for good
# CONFIG_MTD_ONENAND_OTP is not set
# CONFIG_MTD_OOPS is not set
# No framebuffer console: /dev/fb0 is for omaplfb and Harmattan's X
# CONFIG_FRAMEBUFFER_CONSOLE is not set
# USB networking without modules (ramboot/init sets up a CDC ECM gadget in configfs)
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_GADGET=y
CONFIG_USB_MUSB_OMAP2PLUS=y
CONFIG_TWL4030_USB=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ECM=y
# A configuration without a MaxPower of its own (configfs's, as ramboot's ECM) asks the host for
# 500 mA, as stock's gadgets did (g_ether, g_nokia, g_file_storage: bMaxPower 250)
CONFIG_USB_GADGET_VBUS_DRAW=500
# Nokia's Aegis (security/aegis, n9-qemu's port): Harmattan needs its credentials and tokens even in
# open mode (X's security module, upstart's jobs); the only LSM, as on the phone
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_AEGIS=y
CONFIG_SECURITY_AEGIS_VALIDATOR=y
CONFIG_SECURITY_AEGIS_VALIDATOR_INIT_PATH="/usr/sbin/validator-init"
CONFIG_SECURITY_AEGIS_RESTOK=y
CONFIG_SECURITY_AEGIS_CREDS=y
CONFIG_SECURITY_CREDENTIALS_POLICY=y
CONFIG_SECURITY_AEGIS_CREDP=y
CONFIG_LSM="aegis"
# Harmattan: BME drives the TWL5031 over /dev/i2c-1; the rootfs and /home are overlays (ramboot/init)
CONFIG_I2C_CHARDEV=y
CONFIG_OVERLAY_FS=y
# The touchscreen, in protocol A for X's mtev (atmel-mxt-protocol-a.patch)
CONFIG_TOUCHSCREEN_ATMEL_MXT=y
# BME's /dev/twl4030-adc (twl4030-madc-chardev.patch); the driver is IIO's, so the IIO core built in
CONFIG_IIO=y
CONFIG_TWL4030_MADC=y
# Input, built in (only the SGX modules are shipped): evdev for /dev/input (mce, X's mtev), the volume
# keys (TWL keypad), the power button, uinput, and the accelerometer sensord reads orientation from
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_TWL4030=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_INPUT_TWL4030_PWRBUTTON=y
CONFIG_INPUT_UINPUT=y
CONFIG_SENSORS_LIS3_I2C=y
# The charger's presence and type as the "usb"/"vac" power supplies BME reads (twl5031-bcc.patch)
CONFIG_CHARGER_TWL5031_BCC=y
# Performance, after the N9's stock kernel (rm581_defconfig: PREEMPT, HZ 128, cpufreq with a boost on
# input, its PM optimizer): DVFS from omap36xx.dtsi's OPPs (300 MHz to 1 GHz, the N9's cpu0-supply
# and ABB), stock's ondemand (Harmattan's pmconfig; schedutil needs SMP, see below), the input boost
# (cpufreq-input-boost.patch), full preemption, stock's 128 Hz tick (2026-10-05; was 250)
CONFIG_CPUFREQ_DT=y
# CONFIG_CPU_FREQ_GOV_SCHEDUTIL is not set
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPUFREQ_INPUT_BOOST=y
CONFIG_PREEMPT=y
# CONFIG_PREEMPT_NONE is not set
CONFIG_HZ_128=y
# Harmattan's policy mounts cgroup v1 freezer,cpu,memory at /syspart (app partitions, memory limits)
CONFIG_MEMCG_V1=y
# and only those, as stock (rm581_defconfig: no cpuacct, devices; 2.6.32 had no blkio or perf_event
# cgroups, no CFS bandwidth): without them Harmattan's syspart mounts cpu,memory,freezer as on stock,
# and a context switch costs 0.4-0.5 us less (2026-10-05)
# CONFIG_CGROUP_CPUACCT is not set
# CONFIG_CGROUP_PERF is not set
# CONFIG_BLK_CGROUP is not set
# CONFIG_CGROUP_DEVICE is not set
# CONFIG_CFS_BANDWIDTH is not set
# Swap as stock: zram as the ramzswap module Harmattan's enable-swap job loads (modprobe ramzswap,
# rzscontrol /dev/ramzswap0), compressing with LZO1X as stock's
CONFIG_ZRAM=m
CONFIG_ZRAM_DEF_COMP_LZO=y
# The TWL RTC: Harmattan sets the time from /dev/rtc0 (timeconfig), stock keeps it running
CONFIG_RTC_DRV_TWL4030=y
# The signed wireless regulatory database (wireless-regdb, kernel/build.sh fetches it) built in:
# cfg80211 loads it at boot. WLAN's firmware (linux-firmware's, stock's 2011 wl1271-fw.bin is older
# than wlcore accepts) is a file next to this kernel's modules (firmware_class.path, set by the init);
# Nokia's own firmware loads from the phone's /lib/firmware
CONFIG_EXTRA_FIRMWARE="regulatory.db regulatory.db.p7s"
# WLAN (wl12xx-n9-sdio.patch): cfg80211/mac80211 built in (WPA's crypto without module aliases); the
# chip drivers wlcore, wl12xx and wlcore_sdio stay modules, which udev loads by the SDIO alias as on
# stock; Harmattan's wl1271-cal then pushes CAL's NVS through nl80211 testmode, as to Nokia's driver
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_NL80211_TESTMODE=y
CONFIG_WLCORE=m
CONFIG_WL12XX=m
CONFIG_WLCORE_SDIO=m
# Netfilter for Harmattan's connectivity: icd2 adds legacy iptables rules (filter table, the
# IDLETIMER target, which its job modprobes/rmmods, so a module) and wlancond reads NFLOG
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_FILTER=y
CONFIG_NETFILTER_NETLINK_LOG=y
CONFIG_NETFILTER_XT_TARGET_NFLOG=y
CONFIG_NETFILTER_XT_TARGET_IDLETIMER=m
# wlancond's throughput rules (/etc/network/wlan_iptables.sh): Nokia's condition match and
# CONDITION target, and the rate estimator; stock had them as modules, nothing modprobes them
CONFIG_NETFILTER_XT_CONDITION=y
CONFIG_NETFILTER_XT_TARGET_RATEEST=y
CONFIG_NETFILTER_XT_MATCH_RATEEST=y
# Audio as stock: the TWL5031 codec (McBSP3) and the TLV320DAC33 + TPA6140A2 headphone chain
# (McBSP2) as Nokia's two cards, dfl61-twl4030 and dfl61-dac33 (sound-dfl61.patch), which
# Harmattan's PulseAudio requires by name
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_NOKIA_DFL61=y
# MyDocs (FAT) with stock's mount options, which include utf8
CONFIG_NLS_UTF8=y
# The N9 vibra (haptics) for Immersion's immvibed (vibra-apds-n9.patch)
CONFIG_INPUT_VIBRA_SPI=y
# Bluetooth: the WL1271's BT core on UART2 (mainline's DT and hci_nokia, with stock's ti1273.bin);
# the stack built in for Harmattan's bluetoothd (BlueZ 4: raw HCI, RFCOMM, BNEP, HIDP), the UART
# driver a module that udev loads once the root is up, as stock's hci_h4p, so its firmware comes
# from Harmattan's /lib/firmware
CONFIG_BT=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_BNEP=y
CONFIG_BT_HIDP=y
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_NOKIA=m
# The APDS990x ambient light/proximity sensor with Nokia's /dev/apds990x0 for sensord (vibra-apds-n9.patch)
CONFIG_SENSORS_APDS990X=y
# The notification LED (LP5521, omap3-n9-nokia.dtsi), which Harmattan's mce drives: the LED class built
# in (modules aren't shipped), and the multicolour class the LP55xx core depends on
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_LEDS_LP55XX_COMMON=y
CONFIG_LEDS_LP5521=y
# The R&D sleep indicators on GPIO 92 (omap3-n9.dts): with the driver absent the pin floated and both
# lights glowed dimly
CONFIG_LEDS_GPIO=y
# Nokia's IP heartbeat (iphb.patch): DSME's /dev/iphb, keepalives held until its heartbeat
CONFIG_IP_NF_HB=y
# The secure ROM's RNG (Nokia PPA, as the N900's): entropy, and a probe of the secure world (BB5)
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_OMAP3_ROM=y
# The modem (RAPU) on SSI port 1, as mainline's DT has it: the SSI controller, Phonet over SSI
# (ssi_protocol: phonet0, Harmattan's sscd/csd), call audio (cmt_speech: /dev/cmt_speech for
# PulseAudio) and nokia-modem, with nokia_modem.pm=0 (CONFIG_CMDLINE): NOLO leaves the modem powered
# (cmt_en high) and stock's kernel never drove its GPIOs; with pm=1 the driver would pull them low
CONFIG_PHONET=y
CONFIG_HSI=y
CONFIG_OMAP_SSI=y
CONFIG_SSI_PROTOCOL=y
CONFIG_CMT_SPEECH=y
CONFIG_NOKIA_MODEM=y
# Nokia's OMAP3 HS secure-environment driver (omap3-sec-bb5.patch), built in as stock (/dev/omap_sec,
# kci= from NOLO's omap_sec.kci) for Harmattan's own validator-init and libbb5
CONFIG_OMAP3_SEC=y
# OFF mode on the HS N9: the L2 auxiliary control register restored through the PPA (service 43),
# as stock (rm581_defconfig)
CONFIG_OMAP3_L2_AUX_SECURE_SAVE_RESTORE=y
# FUSE, built in as stock: aegisfs (Aegis's crypto filesystem, group-mce) mounts through it once BB5
# verifies its signed config
CONFIG_FUSE_FS=y
# The kernel log kept in RAM across a warm reset (ramoops, pstore-ramoops-n9.patch's region), plain text:
# a panic's log survives into the next test boot
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
# CONFIG_PSTORE_COMPRESS is not set
# Nokia's interfaces for the AK8975 compass (/dev/ak89750, sensord) and the BCM4751 GPS
# (/dev/bcm4751-gps and 3-01fa's sysfs, nped): n9-gps-compass.patch, nodes in omap3-n9-nokia.dtsi
CONFIG_NOKIA_AK8975=y
CONFIG_BCM4751_GPS=y
# Nokia's /dev/pn544 for Harmattan's NFC stack (libNFCDAL, nfcd), stock's pn544.ko
CONFIG_NOKIA_PN544=y
# The cameras as stock, for Harmattan's camera userspace: the ISP (mainline omap3isp, with the 2011
# interfaces Harmattan uses: media ioctls, its v4l2_event, frame user pointers in VRAM, ...) and
# Nokia's own drivers for the N9's sensors, lens and flash (drivers/media/i2c/nokia-camera). The ISP
# built in; the sensor, lens and flash drivers modules that udev loads once the root is up, so the
# sensors' register lists come from Harmattan's /lib/firmware as on stock (whose camera modules
# loaded after the root too). The AS3645A flash controller is Nokia's V4L2 subdev instead of the LED
# class driver: its probe still turns off the red indicator next to the flash, lit after NOLO, as
# stock's camera driver did
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_VIDEO_OMAP3=y
CONFIG_VIDEO_CAMERA_SENSOR=y
CONFIG_VIDEO_NOKIA_SMIAPP=m
CONFIG_VIDEO_NOKIA_AD58XX=m
CONFIG_VIDEO_NOKIA_AS3645A=m
# CONFIG_LEDS_AS3645A is not set
# CONFIG_VIDEO_MT9P031 is not set
# CONFIG_VIDEO_TVP5150 is not set
# USB modes as stock: Harmattan's usb_moded modprobes Nokia's gadget modules, as modules
# (usb-moded-compat.patch: mass storage under its old name g_file_storage, the 2.6.32 sysfs paths).
# SDK mode (g_ether) is the RAM boot's own ECM gadget, with stock's ids (ramboot/init)
CONFIG_USB_G_NOKIA=m
CONFIG_USB_MASS_STORAGE=m
# The WL1273's FM radio as stock: Nokia's drivers from Harmattan (wl1273-core, /dev/radio0, and the
# codec of the third card "dfl61-wl1273", Bluetooth SCO and FM over PCM on McBSP4, with stock's
# controls "Mode Switch", "Codec Mode", "Audio Switch"... that fmrxd and Nokia's test servers set)
CONFIG_MEDIA_RADIO_SUPPORT=y
CONFIG_RADIO_ADAPTERS=y
CONFIG_RADIO_WL1273=y
# The DSP (IVA2.2) for Harmattan's gst-dsp video decode/encode: the TI DSP/BIOS Bridge (staging
# tidspbridge, v3.16 + Nokia's ti_bridge policy), /dev/DspBridge. A module named as stock,
# bridgedriver.ko, which Harmattan loads itself (group-hal.conf; /etc/modprobe.d/bridgedriver:
# shm_size=0x500000 base_img=/lib/dsp/baseimage.dof); needs the "ti,omap3-dspbridge" DT node.
# Its mailbox built in
CONFIG_STAGING=y
CONFIG_TIDSPBRIDGE=m
CONFIG_OMAP2PLUS_MBOX=y
# Kernel speed (the user's decisions, 2026-10-03; README "Kernel speed against stock": syscalls,
# context switches and page faults were 1.7-3.4x slower than stock's 2.6.32): the N9's SoC only, so an
# ARMv7-only kernel (omap2plus also builds the OMAP2 boards, which made the whole kernel ARMv6), with
# stock's 3G/1G split and all of the 1 GB as lowmem; one core, no SMP; no Spectre-v2 mitigations
# and none of the hardening 2.6.32 didn't have either (software PAN, VMAP stacks, zeroed stack
# variables); no syscall audit (stock had none, Harmattan runs no auditd), no schedstats.
# "Typical OMAP configuration" would select highmem: its other selects are listed
CONFIG_VMSPLIT_3G_OPT=y
# CONFIG_HIGHMEM is not set
# CONFIG_SMP is not set
# CONFIG_HARDEN_BRANCH_PREDICTOR is not set
# CONFIG_HARDEN_BRANCH_HISTORY is not set
# CONFIG_ARM_PAN is not set
# CONFIG_VMAP_STACK is not set
CONFIG_INIT_STACK_NONE=y
# no stack protector either (ARM got it in 2.6.36; stock had none): a pipe write+read 1.75 us
# instead of 1.90-1.99 (2026-10-05)
# CONFIG_STACKPROTECTOR is not set
# CONFIG_AUDIT is not set
# CONFIG_SCHEDSTATS is not set
# no uprobes (user-space probes; Harmattan has no tracer for them, kprobes stay): hooks in every
# mmap, munmap and fork
# CONFIG_UPROBE_EVENTS is not set
# CONFIG_UPROBES is not set
# CONFIG_ARCH_MULTI_V6 is not set
# CONFIG_ARCH_OMAP2 is not set
# CONFIG_ARCH_OMAP4 is not set
# CONFIG_SOC_OMAP5 is not set
# CONFIG_SOC_AM33XX is not set
# CONFIG_SOC_AM43XX is not set
# CONFIG_SOC_DRA7XX is not set
# CONFIG_SOC_TI81XX is not set
# CONFIG_ARCH_OMAP2PLUS_TYPICAL is not set
CONFIG_I2C=y
CONFIG_I2C_OMAP=y
CONFIG_NEON=y
CONFIG_VFP=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_TWL4030_CORE=y
CONFIG_TWL4030_POWER=y
CONFIG_CONNECTOR=y
CONFIG_PROC_EVENTS=y
# SmartReflex class 1.5 as stock (board-rm696.c, sr_class1p5_init()): each OPP's voltage
# calibrated once, SR off after; class 3 ran SR all the time
# CONFIG_POWER_AVS_OMAP_CLASS3 is not set
CONFIG_POWER_AVS_OMAP_CLASS1P5=y
# DISPC core clock at least 4x the pixel clock, as stock (board-rm696-video.c: lck_div 1, pck_div 4):
# the video plane scaler needs it to downscale 4x (Xv: a 1080-wide clip into 270 columns)
CONFIG_FB_OMAP2_DSS_MIN_FCK_PER_PCK=4
# RAM as stock's kernel left it (2026-10-09, the user's go): Harmattan's enable-swap job gives 256 MB
# of compressed swap only above 1,000,000 kB of MemTotal (stock: ~1,008,400; with all of the below
# and the kernel changes that go with them, ~1,002,900 here). Every line says how to put it back
# (REMOVED.md "RAM for Harmattan").
# The kernel log in 256 KiB (was 1 MiB plus 3.2 MiB of printk metadata via log_buf_len=1M; a boot's
# log is 49-82 KiB by Harmattan's desktop)
CONFIG_LOG_BUF_SHIFT=18
# No W^X padding around the kernel's text and rodata (stock 2.6.32 had no such protection): 887 KiB
# CONFIG_STRICT_KERNEL_RWX is not set
# IPv6 a module, as stock's (net-pf-10 autoloads it; kernel/build.sh ships ipv6.ko)
CONFIG_IPV6=m
# Built in by omap2plus for other boards, nothing on the N9 or in Harmattan uses them: NFS (and root
# NFS, IP autoconfiguration), UBI/UBIFS (fstab's ubi0:var is noauto; stock had them), zstd, Ethernet,
# ATA/SCSI, PCI, raw NAND/CFI flash (the N9 has OneNAND), JFFS2/CRAMFS/ext2 (ext4 mounts ext2)/quota,
# other boards' PMICs, regulators and DMA, remoteproc, digital/analog TV, SDR and test media drivers,
# USB gadget audio/MIDI/HID/EEM functions, ethtool's netlink, kexec, /proc/config.gz
# CONFIG_NFS_FS is not set
# CONFIG_ROOT_NFS is not set
# CONFIG_IP_PNP is not set
# CONFIG_MTD_UBI is not set
# CONFIG_UBIFS_FS is not set
# CONFIG_CRYPTO_ZSTD is not set
# CONFIG_RD_ZSTD is not set
# CONFIG_ETHERNET is not set
# CONFIG_ATA is not set
# CONFIG_SCSI is not set
# CONFIG_PCI is not set
# CONFIG_PCI_ENDPOINT is not set
# CONFIG_MTD_RAW_NAND is not set
# CONFIG_MTD_CFI is not set
# CONFIG_MTD_PHYSMAP is not set
# CONFIG_JFFS2_FS is not set
# CONFIG_CRAMFS is not set
# CONFIG_EXT2_FS is not set
# CONFIG_QUOTA is not set
# CONFIG_MFD_PALMAS is not set
# CONFIG_MFD_CPCAP is not set
# CONFIG_MFD_TPS65217 is not set
# CONFIG_MFD_TPS65218 is not set
# CONFIG_MFD_TPS65219 is not set
# CONFIG_MFD_TPS65910 is not set
# CONFIG_MFD_TI_LP873X is not set
# CONFIG_MFD_TI_LP87565 is not set
# CONFIG_TWL6040_CORE is not set
# CONFIG_REGULATOR_LP872X is not set
# CONFIG_REGULATOR_TPS65023 is not set
# CONFIG_REGULATOR_TPS6507X is not set
# CONFIG_TI_EDMA is not set
# CONFIG_REMOTEPROC is not set
# CONFIG_MEDIA_DIGITAL_TV_SUPPORT is not set
# CONFIG_MEDIA_ANALOG_TV_SUPPORT is not set
# CONFIG_MEDIA_SDR_SUPPORT is not set
# CONFIG_MEDIA_TEST_SUPPORT is not set
# CONFIG_USB_CONFIGFS_F_UAC1 is not set
# CONFIG_USB_CONFIGFS_F_UAC2 is not set
# CONFIG_USB_CONFIGFS_F_MIDI is not set
# CONFIG_USB_CONFIGFS_F_HID is not set
# CONFIG_USB_CONFIGFS_EEM is not set
# CONFIG_ETHTOOL_NETLINK is not set
# CONFIG_KEXEC is not set
# CONFIG_CRASH_DUMP is not set
# CONFIG_IKCONFIG is not set
