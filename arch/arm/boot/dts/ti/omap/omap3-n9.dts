/*
 * omap3-n9.dts - Device Tree file for Nokia N9
 *
 * Written by: Aaro Koskinen <aaro.koskinen@iki.fi>
 */

/dts-v1/;

#include "omap3-n950-n9.dtsi"
#include <dt-bindings/input/input.h>
#include "omap3-n9-audio.dtsi"
#include "omap3-n9-nokia.dtsi"

/ {
	model = "Nokia N9";
	compatible = "nokia,omap3-n9", "ti,omap3630", "ti,omap3";
};

&i2c2 {
	smia_1: camera@10 {
		compatible = "nokia,smia";
		reg = <0x10>;
		/* No reset gpio */
		vana-supply = <&vaux3>;
		clocks = <&isp 0>;
		clock-frequency = <9600000>;
		flash-leds = <&as3645a_flash &as3645a_indicator>;
		port {
			smia_1_1: endpoint {
				link-frequencies = /bits/ 64 <199200000 210000000 499200000>;
				clock-lanes = <0>;
				data-lanes = <1 2>;
				remote-endpoint = <&csi2a_ep>;
			};
		};
	};
};

&i2c3 {
	ak8975@f {
		compatible = "asahi-kasei,ak8975";
		reg = <0x0f>;
	};
};

&isp {
	vdd-csiphy1-supply = <&vaux2>;
	vdd-csiphy2-supply = <&vaux2>;
	ports {
		port@2 {
			reg = <2>;
			csi2a_ep: endpoint {
				remote-endpoint = <&smia_1_1>;
				clock-lanes = <2>;
				data-lanes = <1 3>;
				crc = <1>;
				lane-polarities = <1 1 1>;
			};
		};
	};
};

&modem {
	compatible = "nokia,n9-modem";
};

&lis302 {
	st,axis-x = <1>;    /* LIS3_DEV_X */
	st,axis-y = <(-2)>; /* LIS3_INV_DEV_Y */
	st,axis-z = <(-3)>; /* LIS3_INV_DEV_Z */

	st,min-limit-x = <(-46)>;
	st,min-limit-y = <3>;
	st,min-limit-z = <3>;

	st,max-limit-x = <(-3)>;
	st,max-limit-y = <46>;
	st,max-limit-z = <46>;
};

&twl_keypad {
	linux,keymap = < MATRIX_KEY(6, 8, KEY_VOLUMEUP)
			 MATRIX_KEY(7, 8, KEY_VOLUMEDOWN)
			 >;
};

/* The display: as the N950's (omap3-n950.dts), with the N9's lanes and panel (from Filip Matijević's
 * N9 display patch for postmarketOS, 2017) */
&omap3_pmx_core {
	dsi_pins: dsi-pins {
		pinctrl-single,pins = <
			OMAP3_CORE1_IOPAD(0x20dc, PIN_OUTPUT | MUX_MODE1) /* dsi_dx0 */
			OMAP3_CORE1_IOPAD(0x20de, PIN_OUTPUT | MUX_MODE1) /* dsi_dy0 */
			OMAP3_CORE1_IOPAD(0x20e0, PIN_OUTPUT | MUX_MODE1) /* dsi_dx1 */
			OMAP3_CORE1_IOPAD(0x20e2, PIN_OUTPUT | MUX_MODE1) /* dsi_dy1 */
			OMAP3_CORE1_IOPAD(0x20e4, PIN_OUTPUT | MUX_MODE1) /* dsi_dx2 */
			OMAP3_CORE1_IOPAD(0x20e6, PIN_OUTPUT | MUX_MODE1) /* dsi_dy2 */
		>;
	};

	display_pins: display-pins {
		pinctrl-single,pins = <
			OMAP3_CORE1_IOPAD(0x20ca, PIN_INPUT | MUX_MODE4) /* gpio 62 - display te */
			OMAP3_CORE1_IOPAD(0x20fe, PIN_OUTPUT | MUX_MODE4) /* gpio 87 - display reset */
		>;
	};
};

/*
 * sgx: the kernel log kept in RAM across a warm reset (pstore/ramoops): with the test kernel armed
 * again, a panic's log survives into the next boot (ramboot/init copies it to MyDocs/.ramboot)
 */
/ {
	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		ramoops@8f000000 {
			compatible = "ramoops";
			reg = <0x8f000000 0x100000>;
			record-size = <0x20000>;
			console-size = <0x40000>;
		};
	};
};

&dss {
	status = "okay";

	vdda_video-supply = <&vdac>;
};

/*
 * sgx: GPIO bank 3 as NOLO left it (no reset at boot, as stock): its gpio 87 holds the panel out of
 * reset, so NOLO's picture stays until Harmattan draws (omapfb-takeover.patch)
 */
&gpio3 {
	ti,no-reset-on-init;
};

&dsi {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&dsi_pins>;

	vdd-supply = <&vpll2>;

	port {
		dsi_out_ep: endpoint {
			remote-endpoint = <&lcd0_in>;
			lanes = <2 3 4 5 0 1>;
		};
	};

	lcd0: panel@0 {
		compatible = "nokia,pyrenees", "panel-dsi-cm";
		reg = <0>;
		label = "lcd";	/* stock's name, which Harmattan's X driver looks for */

		pinctrl-names = "default";
		pinctrl-0 = <&display_pins>;

		vpnl-supply = <&vmmc2>;
		vddi-supply = <&vio>;

		reset-gpios = <&gpio3 23 GPIO_ACTIVE_HIGH>;	/* 87 */
		te-gpios = <&gpio2 30 GPIO_ACTIVE_HIGH>;	/* 62 */

		width-mm = <48>; /* 48.240 mm */
		height-mm = <87>; /* 86.832 mm */

		/* Landscape 854x480, as the stock kernel runs it (rotate 1) for Harmattan's X */
		rotation = <90>;

		/*
		 * The panel's frame is 480x864; stock shows 854 of its rows, from row 0. The DSI
		 * command-mode driver (omapfb's panel-dsi-cm, patched) takes the back porches as the
		 * visible area's offset.
		 */
		panel-timing {
			clock-frequency = <0>;		/* from the frame rate (panel-dsi-cm), DSI adds 1.5x */

			hback-porch = <0>;
			hactive = <480>;
			hfront-porch = <0>;
			hsync-len = <2>;

			vback-porch = <0>;
			vactive = <854>;
			vfront-porch = <10>;
			vsync-len = <1>;

			hsync-active = <0>;
			vsync-active = <0>;
			de-active = <1>;
			pixelclk-active = <1>;
		};

		port {
			lcd0_in: endpoint {
				remote-endpoint = <&dsi_out_ep>;
			};
		};
	};
};

/* TV-out (composite, through the AV jack), as the N900's (omap3-n900.dts): stock has it as display
 * "tv", which Harmattan's X driver requires */
/ {
	tv: connector {
		compatible = "composite-video-connector";
		label = "tv";

		port {
			tv_connector_in: endpoint {
				remote-endpoint = <&venc_out>;
			};
		};
	};
};

&venc {
	status = "okay";

	vdda-supply = <&vdac>;

	port {
		venc_out: endpoint {
			remote-endpoint = <&tv_connector_in>;
			ti,channels = <1>;
		};
	};
};

/*
 * Harmattan on this kernel. Numbering as the stock 2.6.32 kernel's, which Harmattan's userspace
 * hardcodes: I2C buses 1-3 (BME opens /dev/i2c-1 for the TWL5031, FCam /dev/i2c-2), GPIO banks from
 * number 0 (BME: sysfs gpio162), which gpio-omap-legacy-base.patch reads from these aliases.
 */
/ {
	aliases {
		/delete-property/ i2c0;
		i2c1 = &i2c1;
		i2c2 = &i2c2;
		i2c3 = &i2c3;
		gpio0 = &gpio1;
		gpio1 = &gpio2;
		gpio2 = &gpio3;
		gpio3 = &gpio4;
		gpio4 = &gpio5;
		gpio5 = &gpio6;
	};
};

/*
 * No power-off: the test phone's power button is broken, so a phone that powers off stays off.
 * Without a handler, a power-off (DSME's shutdown, check_wipe's SysRq-O) halts instead, and the
 * watchdogs reset the phone into NOLO and stock Harmattan.
 */
&twl_power {
	/delete-property/ ti,use_poweroff;
};

/* The TWL5031's charger (BCC) is not the TWL4030 BCI this node's driver programs; BME drives it */
&charger {
	status = "disabled";
};

/*
 * The CPU's operating points. Stock runs every N9 up to 1 GHz (/etc/pmconfig), so OPP1G is a normal
 * OPP here, whatever the DM37x speed-bin efuse says (mainline makes it turbo-only, for binned parts).
 * Above it, a little overclock as boost OPPs, off by default:
 *	echo 1 > /sys/devices/system/cpu/cpufreq/boost
 * The N9 community's overclocks (talk.maemo.org) went to 1.2-1.3 GHz and settled on 1.2 GHz as the
 * daily ceiling; chips differ (some unstable past 950 MHz, others fine at 1.15 GHz). The ABB stays
 * in FBB (its 1.375 V entry, all ti-abb knows); VDD1 goes up 25 mV for 1.2 GHz (its regulator's
 * maximum is 1.45 V). The thermal zone still throttles.
 */
&cpu0_opp_table {
	opp-1000000000 {
		/delete-property/ turbo-mode;
		opp-supported-hw = <0xffffffff 3>;
	};

	opp-1100000000 {
		opp-hz = /bits/ 64 <1100000000>;
		opp-microvolt = <1375000 1375000 1375000>,
				 <1375000 1375000 1375000>;
		opp-supported-hw = <0xffffffff 3>;
		turbo-mode;
	};

	opp-1200000000 {
		opp-hz = /bits/ 64 <1200000000>;
		opp-microvolt = <1400000 1400000 1400000>,
				 <1375000 1375000 1375000>;
		opp-supported-hw = <0xffffffff 3>;
		turbo-mode;
	};
};

/* The touchscreen, as stock's board file (board-rm696-peripherals.c): IRQ GPIO 61, reset GPIO 81 */
&i2c2 {
	touchscreen@4b {
		compatible = "atmel,maxtouch";
		reg = <0x4b>;
		interrupts-extended = <&gpio2 29 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&gpio3 17 GPIO_ACTIVE_LOW>;
		vdda-supply = <&vaux1>;
		vdd-supply = <&vio>;
	};
};

/* The charger's presence for BME (twl5031-bcc.patch); BME drives the charger itself */
&twl {
	bcc {
		compatible = "ti,twl5031-bcc";
	};
};
